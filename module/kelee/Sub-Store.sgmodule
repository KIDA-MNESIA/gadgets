#!name=Sub-Store
#!desc=高级订阅管理工具，定时任务默认为每天23点55分，可在插件设置中自定义。使用前请在本插件的详情页面为[PROXY]项分配代理策略。
#!author=Peng-YM[https://github.com/Peng-YM]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/Other_icon/120px/Sub-Store.png
#!openUrl=https://sub.store
#!tag=订阅管理
#!loon_version=3.4.0(962)
#!homepage=https://hub.kelee.one
#!date=2026-06-01 17:11:35
#!arguments=cron:"55 23 * * *"

[Rule]
DOMAIN,sub-store.vercel.app,{kelee_proxy_policy}

[Script]
Sub-Store Core = type=http-request, pattern=^https?:\/\/sub\.store\/((download)|api\/(preview|sync|(utils\/node-info))), script-path=https://raw.githubusercontent.com/KIDA-MNESIA/gadgets/main/module/kelee/script-sub-store-1.min-966e5950297fd9c8.js, requires-body=true, timeout=120

Sub-Store Simple = type=http-request, pattern=^https?:\/\/sub\.store, script-path=https://raw.githubusercontent.com/KIDA-MNESIA/gadgets/main/module/kelee/script-sub-store-0.min-7ded59db32c0c77c.js, requires-body=true, timeout=120

Sub-Store Sync = type=cron, cronexp={{{cron}}}, script-path=https://raw.githubusercontent.com/KIDA-MNESIA/gadgets/main/module/kelee/script-cron-sync-artifacts.min-504806e4bf45ae11.js, timeout=120

[MITM]
hostname = %APPEND% sub.store
