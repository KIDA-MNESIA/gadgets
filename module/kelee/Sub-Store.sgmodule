#!name=Sub-Store
#!desc=高级订阅管理工具，定时任务默认为每天23点55分，可在插件设置中自定义。使用前请在本插件的详情页面为[PROXY]项分配代理策略。
#!author=Peng-YM[https://github.com/Peng-YM]
#!icon=icon not found
#!category=Kelee
#!openUrl=https://sub.store
#!category=订阅管理
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49
#!arguments=cron:"55 23 * * *"
#!arguments-desc=cron: 定时参数\n这里需要输入符合CRON表达式的参数

[Script]
Sub-Store Core = type=http-request, pattern=(?i)^https?:\/\/sub\.store\/((download)|api\/(preview|sync|(utils\/node-info))), script-path=https://raw.githubusercontent.com/KIDA-MNESIA/gadgets/main/module/kelee/script-sub-store-org_sub-store-1.min-8f06453e5a3b5548.js, requires-body=true, timeout=120

Sub-Store Simple = type=http-request, pattern=(?i)^https?:\/\/sub\.store, script-path=https://raw.githubusercontent.com/KIDA-MNESIA/gadgets/main/module/kelee/script-sub-store-org_sub-store-0.min-45a1e55654d98f5f.js, requires-body=true, timeout=120

Sub-Store Sync = type=cron, cronexp="{{{cron}}}", script-path=https://raw.githubusercontent.com/KIDA-MNESIA/gadgets/main/module/kelee/script-sub-store-org_cron-sync-artifacts.min-fea8cb5fb60efb09.js, timeout=120

[MITM]
hostname = %APPEND% sub.store

