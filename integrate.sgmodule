http-response-jq (?i)^https:\/\/info\.amap\.com\/ws\/shield\/search\/poi\/detail\? 'def keep_skeleton:   IN(     "baseInfo",                    # 地点本体：名称/坐标/评分/标签/图标     "poiDetailCommonConfig",       # 详情页通用配置（含上滑引导文案）     "navbarMore",                  # 右上角更多菜单     "backToTop",                   # 回到顶部     "poiDetailBottomBar",          # 底部操作栏（导航/电话/收藏）     "poiMapModule",                # 地点在哪：地图与静态位置图     "anchor",                      # 页内锚点跳转     "reSortContentAndSimilar",     # 内容排序策略开关，本身不是内容     "comprehensiveEditEntrance",   # 编辑/纠错入口     "functionZone",                # 功能区（写评价/订座/预约）     "poiTipBar",                   # 顶部提示条：本店 IM 咨询入口     "floatTelButton",              # 悬浮电话按钮     "footer_tel_button",           # 吸底电话按钮     "footer_retain_button"         # 吸底留存按钮   );                                                            # end def keep_skeleton     def keep_ugc:   IN(     "attractGalleryInfo",          # 顶部图集     "combineReviews",              # 评价     "evaluateVO", "reviews",       # 评价数据     "inviteReview",                # 邀请评价     "seriousPublicExperience", "societyPublicExperience",     "poiDetailRankUpCard",         # 榜单/排名     "travelGuideAndQa",            # 旅行攻略与问答     "poiDetailAQModule",           # 详情页问答     "AIStreetTips",                # 扫街锦囊：AI 生成的地点提示     "expertNote",                  # 达人笔记     "recommend_food",              # 网友推荐菜：本店菜品     "shopNews",                    # 本店动态     "mallNews",                    # 本商场动态     "shopBaseCase"                 # 本店案例   );                                                            # end def keep_ugc     def keep_intro:   IN(     "wikiInfo", "wikiInfoBelow",     "poiDetailNote", "poiDetailWikiAndLOI"   );                                                            # end def keep_intro     def keep_poi_data:   IN(     "human_traffic",               # 人流量     "floorGuideGbf",               # 楼层/商铺导览     "houseEvaluationInfo",         # 本楼盘测评     "residentialOwnersVO",         # 本小区业主信息