eep_compliance      def keep_booking:   IN(     "scenic_ticket",               # 本景点门票     "movieBookingShelf",           # 本影院影票     "hotelRooms",                  # 本酒店房型     "ktvBookingShelf",             # 本店包间     "venueBookingShelfModule",     # 本店场地     "reserveShelf",                # 本店预订     "DinnerBottomBar",             # 本店订座底部条     "poiDetailAppointmentRegister" # 到店预约登记   );                                                            # end def keep_booking  def keep_module:   keep_skeleton or keep_ugc or keep_intro or keep_poi_data   or keep_service or keep_guide or keep_compliance or keep_booking;  def keep_ref:   (type == "string") and keep_module;                          # end def keep_ref  def at($keys):   reduce $keys[] as $k (.; if type == "object" then .[$k] else null end);      def filter_refs:   if type == "array"   then map(select((type != "string") or keep_module))   else . end;                                                  # end def filter_refs      def anchor_item_kept:   (type == "object")   and ((.anchor | type) == "array")   and any(.anchor[]; keep_ref);                                # end def anchor_item_kept     def panel_item_kept:   if (type == "object") and ((.modulesMap | type) == "array")   then any(.modulesMap[]; keep_ref)   else true end;                                               # end def panel_item_kept    def trim_detail:    if (.data | type) == "object" then      (if (.data.regions | type) == "object" then        .data.regions |= with_entries(.value |= filter_refs)      else . end)      | (if (.data.modules | type) == "object" then          .data.modules |= with_entries(select(.key | keep_module))        else . end)      | (if (at(["data", "meta", "half_hidden_modules"]) | type) == "array" then          .data.meta.half_hidden_modules |= filter_refs        else . end)       | (if (at(["data", "modules", "baseInfo", "data", "user"]) | type) == "object" then          .data.modules.baseInfo.data.user |= del(.userLocRge